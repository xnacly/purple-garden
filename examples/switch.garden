# Match chains opt::ir::switch_fold turns into a Switch: one subject compared
# against at least four distinct keys. `beta` repeats, the first arm wins.
import "opt"
import "str"
import "testing"

#! Map a keyword to its index, 0 when unknown.
fn keyword(w:Str) Int {
    match {
        w == "alpha" { 1 }
        w == "beta" { 2 }
        w == "gamma" { 3 }
        w == "beta" { 99 }
        w == "delta" { 4 }
        { 0 }
    }
}

#! Map a sparse set of integers to their position, 0 otherwise.
fn sparse(n:Int) Int {
    match {
        n == 3 { 1 }
        n == 7 { 2 }
        n == 9 { 3 }
        n == 42 { 4 }
        { 0 }
    }
}

#! Doubles by index, the lookup is n's last use.
fn weight(n:Int) Double {
    match {
        n == 0 { 0.5 }
        n == 1 { 1.5 }
        n == 2 { 2.5 }
        n == 3 { -4.0 }
        { 9.0 }
    }
}

#! weight's lookup inlined, n is still read after it.
fn scaled(n:Int) Double {
    weight(n) * (n as Double)
}

testing.assert(keyword("alpha") == 1)
testing.assert(keyword(opt.or(str.slice("xbetax" 1 5) "")) == 2)
testing.assert(keyword("delta") == 4)
testing.assert(keyword("epsilon") == 0)
testing.assert(sparse(9) == 3)
testing.assert(sparse(42) == 4)
testing.assert(sparse(8) == 0)
testing.assert((weight(2) * 2.0) as Int == 5)
testing.assert(weight(3) < -3.9)
testing.assert((weight(-1) as Int) == 9)
testing.assert((scaled(1) * 2.0) as Int == 3)
testing.assert((scaled(3) as Int) == -12)
testing.assert((scaled(9) as Int) == 81)
