#! Classify keys kw_(i % M) for i in [1, n], summing the indices.
fn sweep(i:Int acc:Int) Int {
    match {
        i == 0 { acc }
        { sweep(i - 1 acc + classify(str.concat("kw_" str.from(i % 600)))) }
    }
}

testing.assert(sweep(200000 0) == 41528550)
