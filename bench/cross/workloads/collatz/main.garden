# Sum of Collatz step counts from 1 to N. Mixed branching, integer division,
# modulo, multiplication.
import "testing"

#! Return whether `n` is even using modulo arithmetic.
fn is_even(n:Int) Bool {
    n % 2 == 0
}

#! Count Collatz steps for `n`, accumulating the total in `acc`.
fn collatz_steps(n:Int acc:Int) Int {
    match {
        n == 1 { acc }
        is_even(n) { collatz_steps(n / 2  acc + 1) }
        { collatz_steps(3 * n + 1  acc + 1) }
    }
}

#! Sum Collatz step counts for every integer from `i` through `n`.
fn sum_steps(i:Int n:Int acc:Int) Int {
    match {
        i > n { acc }
        { sum_steps(i + 1  n  acc + collatz_steps(i 0)) }
    }
}

# Steps for 1..30000 sum to 2864311 (independently computed). Sized so compute
# dominates process startup; at 1..1000 the run was ~60k steps and LuaJIT's
# wall time scattered by ~10% from startup and trace-compile jitter alone.
testing.assert(sum_steps(1 30000 0) == 2864311)
